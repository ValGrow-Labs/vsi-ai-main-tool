# ============================================================
# VSI environment variables. NAMES ONLY. Never put a real value in this file.
# ============================================================
# Local development : copy this file to .env.local and fill it in. .env* is gitignored.
# Staging           : set the same names in the hosting platform for the staging deployment,
#                     pointing at the STAGING Supabase project.
# Production        : set them in the hosting platform for production, pointing at the
#                     PRODUCTION Supabase project. Never reuse staging keys in production.
#
# Only names starting with NEXT_PUBLIC_ are sent to the browser. Everything else is
# server-only and must stay that way: do not rename a secret to NEXT_PUBLIC_.
# Full guide: docs/architecture/VSI_SUPABASE_SETUP.md
# ============================================================

# ---- Supabase (required) -----------------------------------
# Project Settings -> API. The URL and the anon (publishable) key are public by design:
# they reach the browser, and Row Level Security is what protects the data.
# While the URL is the placeholder below, the app runs in local "no database" mode:
# sign-in is a local cookie session (never in production) and pages show empty states.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# VSI does not use the service-role key anywhere. Do not add it unless a server-only
# feature is built that needs it, and never with a NEXT_PUBLIC_ prefix.

# ---- Search data (paid; used only when a user starts a check) ----
# SERPAPI_KEY is the one to set. SERPAPI_API_KEY is an older name for the same key.
SERPAPI_KEY=
SERPAPI_API_KEY=
# Optional serper.dev key. Used for Google rankings only when set and different from the key above.
SERPER_API_KEY=
# Legacy name, last fallback for the SerpAPI key. Leave empty.
SEARCHAPI_KEY=

# ---- AI providers (paid; server-only) ----------------------
# OPENROUTER_API_KEY is effectively required: improvement briefs, reports, citation strategy
# and answer analysis fail without it. The others are optional.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_API_KEY is accepted as another name for GEMINI_API_KEY.
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Optional. Preferred provider for AI Chat: OPENAI, GEMINI, ANTHROPIC or OPENROUTER.
AI_PROVIDER=
# Optional. Page fetching for citation work. Without it a free fetch is used.
FIRECRAWL_API_KEY=

# ---- Scheduled checks (optional; leave empty to keep them off) ----
# Bearer token for POST /api/cron/run-due-clients. While it is empty the route answers 503.
# Scheduled checks spend paid credits without anyone clicking, so keep this empty unless
# you have decided to run them.
CRON_SECRET=

# ---- Analytics (optional) ----------------------------------
# Salt for hashing user ids in analytics_events. Set a long random string per environment.
# Without it a new salt is made at every restart, so the hashes change each time.
ANALYTICS_SALT=

# ---- QA tester checklist (optional; leave empty to keep it off) ----
# /qa is an internal checklist for named pilot testers. It is off (404) unless
# VSI_QA_ENABLED=true AND QA_COOKIE_SECRET is a random string of 32+ characters, which signs
# the tester cookie. Keep it off in production unless a test round is running.
# Migration 044 also disables the QA functions in the database; for a staging QA round run
# supabase/manual/qa_enable_staging.sql (it rotates the tester codes first).
VSI_QA_ENABLED=
QA_COOKIE_SECRET=

# ---- Google sign-in (LOCAL DEVELOPMENT ONLY) ---------------
# This custom Google flow only creates a local cookie session. It is switched off whenever
# a real Supabase project is configured, and always in production. Leave empty for staging
# and production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google

# ---- Local development session (optional) ------------------
# Only used when Supabase is a placeholder and NODE_ENV is not production: the login page then
# makes a cookie session for whatever email was entered. It is a plain member by default. Set
# super_admin to open /admin locally. It is never used with a real Supabase project.
VSI_DEV_SESSION_ROLE=

# ---- Build (optional) --------------------------------------
# Set to 1 to build a standalone server bundle for Docker. Leave empty on Vercel.
BUILD_STANDALONE=
